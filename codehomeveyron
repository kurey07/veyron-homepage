<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title>Veyron Hero</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#07050f;
    --bg2:#120c22;
    --accent:#0058ff;
    --accent2:#8fb1ff;
    --ink:#f4f2fb;
    --muted:#9089ad;
    --line:rgba(143,177,255,0.16);
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  body{
    font-family:'Inter',sans-serif;
    background:var(--bg);
    color:var(--ink);
    -webkit-font-smoothing:antialiased;
  }
  .hero{
    position:relative;
    min-height:640px;
    overflow:hidden;
    background:
      radial-gradient(ellipse at 78% 20%, rgba(0,88,255,0.30), transparent 55%),
      linear-gradient(180deg, var(--bg2) 0%, var(--bg) 65%);
    border:1px solid var(--line);
  }
  /* angular wing shape, evokes the V mark without an image asset */
  .wing{
    position:absolute;
    top:0;
    right:-4%;
    width:58%;
    height:100%;
    pointer-events:none;
  }
  .wing svg{
    position:absolute;
    top:50%;
    right:0;
    transform:translateY(-50%);
    width:100%;
    height:auto;
    filter:drop-shadow(0 0 60px rgba(0,88,255,0.35));
  }
  .wing::after{
    content:"";
    position:absolute;
    inset:0;
    background:linear-gradient(90deg, var(--bg) 0%, transparent 30%);
  }
  nav{
    position:relative;
    z-index:2;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:28px 48px;
  }
  .logo{
    font-family:'Rajdhani',sans-serif;
    font-weight:700;
    font-size:22px;
    letter-spacing:0.08em;
  }
  .navlinks{
    display:flex;
    gap:34px;
    list-style:none;
    font-size:14px;
    color:var(--muted);
  }
  .navlinks li.active{color:var(--ink);}
  .navcta{
    display:flex;
    gap:14px;
    align-items:center;
  }
  .btn{
    font-family:'Inter',sans-serif;
    font-size:13px;
    font-weight:600;
    padding:10px 20px;
    border-radius:3px;
    cursor:pointer;
    border:1px solid var(--line);
    background:transparent;
    color:var(--ink);
  }
  .btn.primary{
    background:var(--accent);
    border-color:var(--accent);
  }
  .content{
    position:relative;
    z-index:2;
    padding:70px 48px 40px;
    max-width:640px;
  }
  .kicker{
    font-family:'Rajdhani',sans-serif;
    font-size:14px;
    font-weight:600;
    color:var(--accent2);
    letter-spacing:0.14em;
    margin-bottom:14px;
  }
  h1{
    font-family:'Rajdhani',sans-serif;
    font-weight:700;
    font-size:76px;
    line-height:0.92;
    letter-spacing:0.01em;
  }
  .sub{
    font-family:'Rajdhani',sans-serif;
    font-weight:600;
    font-size:22px;
    letter-spacing:0.16em;
    color:var(--muted);
    margin-top:6px;
  }
  p.tagline{
    margin-top:22px;
    font-size:16px;
    line-height:1.55;
    color:var(--muted);
    max-width:420px;
  }
  .actions{
    display:flex;
    gap:14px;
    margin-top:32px;
  }
  .actions .btn{padding:13px 26px;font-size:14px;}
  .divisions{
    position:relative;
    z-index:2;
    display:flex;
    gap:28px;
    padding:0 48px 40px;
    border-top:1px solid var(--line);
    margin-top:24px;
    padding-top:20px;
  }
  .divisions span{
    font-size:12px;
    color:var(--muted);
    padding-left:14px;
    border-left:2px solid var(--accent);
  }
  .divisions span.dim{border-left-color:var(--line);color:#5b5578;}
  .meta{
    position:absolute;
    bottom:28px;
    right:48px;
    z-index:2;
    text-align:right;
    font-size:12px;
    color:var(--muted);
    line-height:1.6;
  }
  @media (max-width:720px){
    .hero{min-height:auto;}
    nav{padding:20px 22px;flex-wrap:wrap;gap:14px;}
    .navlinks{display:none;}
    .content{padding:48px 22px 28px;}
    h1{font-size:44px;}
    .sub{font-size:16px;}
    .meta{position:static;text-align:left;padding:0 22px 28px;}
    .divisions{flex-wrap:wrap;padding:0 22px 28px;}
  }
 
  .logo{height:32px;width:auto;display:block;}
  .hero-logo{height:120px;width:auto;display:block;margin-bottom:4px;}
  @media (max-width:720px){
    .hero-logo{height:76px;}
  }
</style>
</head>
<body>
 
<div class="hero">
  <div class="wing">
    <svg viewBox="0 0 600 700" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="beam1" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#0058ff" stop-opacity="0"/>
          <stop offset="50%" stop-color="#0058ff" stop-opacity="0.55"/>
          <stop offset="100%" stop-color="#c9dcff" stop-opacity="0.9"/>
        </linearGradient>
        <linearGradient id="beam2" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#0033a0" stop-opacity="0"/>
          <stop offset="100%" stop-color="#0058ff" stop-opacity="0.45"/>
        </linearGradient>
        <radialGradient id="beamGlow" cx="65%" cy="40%" r="60%">
          <stop offset="0%" stop-color="#0058ff" stop-opacity="0.4"/>
          <stop offset="100%" stop-color="#0058ff" stop-opacity="0"/>
        </radialGradient>
        <filter id="soft" x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur stdDeviation="14"/>
        </filter>
      </defs>
 
      <circle cx="360" cy="260" r="320" fill="url(#beamGlow)"/>
 
      <g filter="url(#soft)" opacity="0.55">
        <polygon points="120,700 260,-40 340,-40 200,700" fill="url(#beam2)"/>
        <polygon points="260,700 380,-40 430,-40 310,700" fill="url(#beam2)"/>
      </g>
 
      <polygon points="210,700 370,-40 420,-40 260,700" fill="url(#beam1)"/>
 
      <g opacity="0.8">
        <circle cx="470" cy="120" r="2.5" fill="#c9dcff"/>
        <circle cx="510" cy="210" r="1.8" fill="#8fb1ff"/>
        <circle cx="440" cy="320" r="2" fill="#c9dcff"/>
        <circle cx="520" cy="420" r="1.5" fill="#8fb1ff"/>
        <circle cx="400" cy="90" r="1.5" fill="#8fb1ff"/>
      </g>
    </svg>
  </div>
 
  <nav>
    <img class="logo" src="data:image/png;base64," alt="Veyron">
    <ul class="navlinks">
      <li class="active">Home</li>
      <li>Teams</li>
      <li>Players</li>
      <li>News</li>
      <li>About</li>
      <li>Contact</li>
    </ul>
    <div class="navcta">
      <button class="btn primary">Join</button>
    </div>
  </nav>
 
  <div class="content">
    <div class="kicker">ESPORTS ORGANIZATION</div>
    <img class="hero-logo" src="data:image/png;base64," alt="Veyron">
    <div class="sub">MÁS QUE UN EQUIPO. UNA VISIÓN.</div>
    <p class="tagline">
      Competimos, creamos contenido y construimos comunidad en Fortnite,
      Valorant y Rocket League. Un solo objetivo: llevar a nuestros
      jugadores al siguiente nivel, dentro y fuera del juego.
    </p>
    <div class="actions">
      <button class="btn primary">Nuestros equipos</button>
      <button class="btn">Últimas noticias</button>
    </div>
  </div>
 
  <div class="divisions">
    <span>FORTNITE</span>
    <span>VALORANT</span>
    <span>ROCKET LEAGUE</span>
    <span class="dim">Y MÁS...</span>
  </div>
 
  <div class="meta">
    EST. 2026<br>
    COMPETITIVE. CREATIVE. GLOBAL.
  </div>
</div>
 
</body>
</html>
 
